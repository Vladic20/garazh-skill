# Narration needs ONE key. Recommended: OpenRouter — free Fish Audio voices (fish-audio/s2.1-pro-free:free), any Fish voice id.
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: Fish Audio direct API (needs paid Fish *API* credit; the free Fish plan credits are for the website only).
FISH_AUDIO_API_KEY=
# Optional: default narrators per language (fish.audio/m/<id>); a story.json "voice" overrides them.
# TVHEAD_VOICE_EN=bf322df2096a46f18c579d0baa36f41d
# TVHEAD_VOICE_RU=868377a7b08f4c0d9acf8c9f059571aa
# Optional: TTS model. Default is free; fish-audio/drama-3 is paid ($2 per 1M chars) and more "acted".
# TVHEAD_TTS_MODEL=fish-audio/s2.1-pro-free:free
# Optional: precise word timestamps for captions/cues via whisper-turbo (~$0.0002 per minute). Default off = free local alignment.
# TVHEAD_STT=on
# Optional: app port (default 4777)
# TVHEAD_PORT=4777
