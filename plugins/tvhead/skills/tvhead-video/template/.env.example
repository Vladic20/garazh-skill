# Narration needs ONE key. Recommended: OpenRouter — Fish Audio TTS (fish-audio/drama-3) + word timings for captions.
#   https://openrouter.ai/keys
OPENROUTER_API_KEY=
# …or directly Fish Audio (https://fish.audio → API keys). Works, but captions/cues use estimated word timings.
FISH_AUDIO_API_KEY=
# Optional: default narrator for every episode (fish.audio/m/<id>); a story.json "voice" overrides it.
# TVHEAD_VOICE=bf322df2096a46f18c579d0baa36f41d
