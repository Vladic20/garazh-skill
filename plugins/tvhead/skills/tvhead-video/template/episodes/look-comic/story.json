      "say": {
        "ru": "Один удар — и злодей повержен. БУМ!"
      },
      "set": {
        "type": "burst",
        "colors": [
          "#ff8a1a",
          "#e8202a"
        ]
      },
      "cam": "push-fast",
      "transition": "zoom",
      "cast": [
        {
          "id": "hero",
          "x": 820,
