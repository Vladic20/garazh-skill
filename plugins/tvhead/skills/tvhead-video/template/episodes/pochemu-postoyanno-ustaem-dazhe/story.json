{
  "title": {
    "en": "Tired, but you slept",
    "ru": "Устал, хотя выспался"
  },
  "languages": [
    "en",
    "ru"
  ],
  "style": "calm, low, reflective",
  "mood": "dark",
  "theme": "paper",
  "transition": "curve",
  "scenes": [
    {
      "note": "Hero in bed, alarm clock; he gets up already exhausted",
      "say": {
        "en": "You slept eight hours. And you still woke up tired.",
        "ru": "Ты спал восемь часов. И всё равно проснулся уставшим."
      },
      "cast": [
        {
          "id": "me",
          "x": 330,
          "face": "tired",
          "pose": "hip"
        }
      ],
      "props": [
        {
          "type": "bed",
          "x": 700,
          "y": 615,
          "enter": "none",
          "z": -1
        },
        {
          "type": "clock",
          "x": 900,
          "y": 300,
          "speed": 10,
          "at": 0.2
        }
      ],
      "cam": "push"
    },
    {
      "note": "Kinetic title: sleep is not the same as rest",
      "transition": "zoom",
      "say": {
        "en": "Because sleep... is not the same thing as rest.",
        "ru": "Потому что сон... это не то же самое, что отдых."
      },
      "layout": "title",
      "props": [
        {
          "id": "title",
          "type": "words",
          "size": 92,
          "emph": [
            "rest",
            "отдых"
          ]
        }
      ]
    },
    {
      "note": "Hero with a phone, notifications pile up around him",
      "say": {
        "en": "From the moment you open your eyes, something is asking for your attention.",
        "ru": "С той секунды, как ты открыл глаза, что-то требует твоего внимания."
      },
      "cast": [
        {
          "id": "me",
          "x": 520,
          "pose": "phone",
          "hold": "phone",
          "face": "neutral"
        }
      ],
      "props": [
        {
          "type": "bell",
          "x": 820,
          "y": 250,
          "count": 3,
          "at": 0.25
        },
        {
          "type": "like",
          "x": 980,
          "y": 380,
          "count": "27",
          "at": 0.45
        },
        {
          "type": "bubble",
          "x": 760,
          "y": 470,
          "text": "???",
          "dir": "right",
          "at": 0.65
        }
      ],
      "cam": {
        "focus": [
          640,
          400
        ],
        "zoom": 1.12
      }
    },
    {
      "note": "Kinetic words: the small decisions, key words underlined",
      "transition": "page",
      "say": {
        "en": "Thousands of tiny decisions. Reply or ignore. Scroll or stop.",
        "ru": "Тысячи мелких решений. Ответить или нет. Листать дальше или остановиться."
      },
      "ground": false,
      "props": [
        {
          "id": "title",
          "type": "words",
          "size": 80,
          "emph": [
            "Thousands",
            "Тысячи"
          ]
        }
      ],
      "layout": "title"
    },
    {
      "note": "Brain icon with an anxious scribble growing over it",
      "say": {
        "en": "Your body was in bed. Your brain never clocked out.",
        "ru": "Тело лежало в кровати. А мозг так и не ушёл с работы."
      },
      "keep": false,
      "props": [
        {
          "type": "brain",
          "x": 640,
          "y": 330,
          "scale": 1.6
        },
        {
          "type": "scribble",
          "x": 640,
          "y": 330,
          "r": 120,
          "at": 0.55,
          "enter": "fade"
        }
      ],
      "ground": false,
      "cam": "push-fast"
    },
    {
      "note": "Battery draining while the hero scrolls",
      "transition": "whip",
      "say": {
        "en": "And scrolling isn't a break. It's just a quieter kind of work.",
        "ru": "А лента — это не перерыв. Это просто более тихая работа."
      },
      "cast": [
        {
          "id": "me",
          "x": 470,
          "pose": "phone",
          "hold": "phone",
          "face": "hypno"
        }
      ],
      "props": [
        {
          "type": "battery",
          "x": 860,
          "y": 300,
          "level": 0.9,
          "drain": 3.5
        }
      ]
    },
    {
      "note": "Grid of identical tired screens; one is calm",
      "transition": "page",
      "say": {
        "en": "Most of us live like this. Always on. Never charged.",
        "ru": "Большинство живёт именно так. Всегда включены. Никогда не заряжены."
      },
      "ground": false,
      "props": [
        {
          "type": "grid",
          "x": 640,
          "y": 540,
          "rows": 3,
          "cols": 7,
          "cell": 125,
          "face": "tired",
          "odd": 10,
          "oddFace": "happy",
          "oddAt": 2.6
        }
      ]
    },
    {
      "note": "Checklist of real rest",
      "transition": "curve",
      "say": {
        "en": "Real rest is boring. A walk. A window. Ten minutes of nothing.",
        "ru": "Настоящий отдых скучный. Прогулка. Окно. Десять минут ничего."
      },
      "ground": false,
      "props": [
        {
          "type": "checklist",
          "x": 500,
          "y": 340,
          "step": 0.9,
          "items": {
            "en": [
              "a walk",
              "a window",
              "10 min of nothing"
            ],
            "ru": [
              "прогулка",
              "окно",
              "10 минут ничего"
            ]
          },
          "size": 52
        }
      ]
    },
    {
      "note": "Hero puts the phone down, sun comes out",
      "transition": "iris",
      "say": {
        "en": "[softly] Your mind doesn't need more sleep. It needs silence.",
        "ru": "[тихо] Твоему разуму не нужно больше сна. Ему нужна тишина."
      },
      "cast": [
        {
          "id": "me",
          "x": 600,
          "pose": "idle",
          "face": "blank",
          "then": [
            {
              "at": 0.55,
              "face": "happy",
              "pose": "raise"
            }
          ]
        }
      ],
      "props": [
        {
          "type": "sun",
          "x": 950,
          "y": 200,
          "at": 0.55
        }
      ],
      "cam": "pull",
      "hold": 0.8
    }
  ]
}